# Copy this file to .env for local development. Do not put real secrets in this template.
VISO_APP_NAME=VISO PRO API
VISO_ENVIRONMENT=development
VISO_DATABASE_URL=postgresql+psycopg://viso_user:change_me@localhost:5432/viso_pro
VISO_AUTH_TOKEN_SECRET=
VISO_AUTH_TOKEN_TTL_MINUTES=30
# New uploads use Cloudinary. Keep credentials only in backend environment.
VISO_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# S3 settings remain available for rollback and existing S3-backed records.
VISO_S3_BUCKET=
VISO_S3_REGION=us-east-1
VISO_S3_ENDPOINT_URL=
# Optional static credentials; production can use the host's IAM role instead.
VISO_S3_ACCESS_KEY_ID=
VISO_S3_SECRET_ACCESS_KEY=
# Only for temporary AWS credentials (for example, an active Learner Lab session).
VISO_S3_SESSION_TOKEN=
VISO_S3_PRESIGNED_URL_TTL_SECONDS=300
VISO_CORS_ORIGINS=https://viso-pro.vercel.app,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
